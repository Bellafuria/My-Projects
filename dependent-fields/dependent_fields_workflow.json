        "jsCode": "const companyData = $('crm.company.get').first().json.result;\n\nconst groups = companyData[\"UF_CRM_XXXXXXXXXXXXX\"] || [];\nconst parmesanValue = companyData[\"UF_CRM_XXXXXXXXXXXXX\"];\n\nconst hasCheese = groups.map(String).includes(\"216\");\nconst isParmesanEmpty = parmesanValue === null || parmesanValue === undefined || parmesanValue === \"\";\n\nlet resultAction = \"stop\"; // По умолчанию — стоп\n\nif (hasCheese && isParmesanEmpty) {\n    resultAction = \"write\";\n} else if (!hasCheese && !isParmesanEmpty) {\n    resultAction = \"clear\";\n}\n\nreturn {\n  action: resultAction\n};"
