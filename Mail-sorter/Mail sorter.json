    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const subject = $json.subject || '';\nconst text = $json.text || '';\n\n// Пытаемся вытащить время из темы или текста\n// Примеры: \"сегодня, 15:00 — 16:00\", \"15:00-16:00\" и т.д.\n\nlet dateFrom = new Date();\nlet dateTo = new Date(dateFrom.getTime() + 60 * 60 * 1000); // +1 час по умолчанию\n\nconst timeMatch = (subject + ' ' + text).match(/(\\d{1,2}):(\\d{2})\\s*[—–-]\\s*(\\d{1,2}):(\\d{2})/);\n\nif (timeMatch) {\n  const today = new Date();\n  dateFrom = new Date(today.getFullYear(), today.getMonth(), today.getDate(), \n                      parseInt(timeMatch[1]), parseInt(timeMatch[2]));\n  dateTo = new Date(today.getFullYear(), today.getMonth(), today.getDate(), \n                    parseInt(timeMatch[3]), parseInt(timeMatch[4]));\n}\n\n// Формат для Bitrix24 (ISO)\nconst fromStr = dateFrom.toISOString().slice(0, 19);\nconst toStr = dateTo.toISOString().slice(0, 19);\n\nreturn {\n  json: {\n    name: (subject || 'Событие из почты').replace(/\"/g, \"'\").substring(0, 100),\n    dateFrom: fromStr,\n    dateTo: toStr,\n    description: (text || '').replace(/\"/g, \"'\").replace(/\\n/g, ' ').substring(0, 400)\n  }\n};"
      },
