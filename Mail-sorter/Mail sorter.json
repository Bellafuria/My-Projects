    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const subject = $json.subject || '';\nconst text = $json.text || '';\n\n// ID лида\nconst idMatch = subject.match(/ID:\\s*(\\d+)/i) || text.match(/lead\\/details\\/(\\d+)/i);\nconst leadId = idMatch ? idMatch[1] : '';\n\n// Ответственный\nconst responsibleMatch = text.match(/Ответственный:\\s*([^\\n\\r]+)/i);\nconst responsible = responsibleMatch ? responsibleMatch[1].trim() : '';\n\n// Ссылка\nconst linkMatch = text.match(/https:\\/\\/summa-plus\\.bitrix24\\.ru\\/crm\\/lead\\/details\\/\\d+/i);\nconst link = linkMatch ? linkMatch[0] : '';\n\nreturn {\n  json: {\n    date: $json.date || '',\n    leadId: leadId,\n    responsible: responsible,\n    link: link,\n    subject: subject\n  }\n};"
      },
