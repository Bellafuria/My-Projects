        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"mistral-small-latest\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты классификатор корпоративной почты. Отвечай ТОЛЬКО одним словом в нижнем регистре: spam или unknown. spam — реклама, рассылки, уведомления сервисов, нерелевантные предложения. unknown — реальные письма от людей, запросы, коммерческие предложения. Никаких объяснений и знаков препинания.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.userPrompt }}\"\n    }\n  ],\n  \"temperature\": 0.1,\n  \"max_tokens\": 10\n}",
        "options": {}
      },
